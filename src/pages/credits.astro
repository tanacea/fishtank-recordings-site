---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import DiveInCta from '../components/DiveInCta.astro';
import PlaylistEmbed from '../components/PlaylistEmbed.astro';
import SpotifyTracks from '../components/SpotifyTracks.vue';
import { credits, business as b } from '../data/site';
import { discography, trackCount, artistCount } from '../data/discography';

const schema = [{
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: 'Lucio Rubino credits',
  itemListElement: credits.map((c, i) => ({
    '@type': 'ListItem', position: i + 1,
    name: `${c.artist}: ${c.work}${c.year ? ` (${c.year})` : ''}, ${c.role}`,
  })),
}];
---
<Base
  title="Lucio Rubino Credits: Paramore, RED, Grey Daze | The Fish Tank"
  description="Lucio Rubino’s credits: 95 songs across Paramore, STARSET, RED, Grey Daze, Larry Coryell, Seventh Day Slumber, Manafest, StorySide:B and dozens of independent artists."
  schema={schema}
  crumbs={[{ name: 'Credits', path: '/credits/' }]}
>
  <PageHero eyebrow="Discography" title="The <em>liner notes.</em>" lede="A Platinum album, a Billboard Top 10 rock record, a BMI radio honor and dozens of independent releases. Below: Lucio Rubino’s headline credits as a producer, songwriter, multi-instrumentalist and artist, followed by every song." />

  <section class="section">
    <div class="wrap">
      <div class="tbl" role="table" aria-label="Credits">
        <div class="tbl__head" role="row">
          <span role="columnheader">Artist</span><span role="columnheader">Release</span><span role="columnheader">Role</span><span role="columnheader">Year</span>
        </div>
        {credits.map((c) => (
          <div class={`tbl__row ${c.featured ? 'is-feat' : ''}`} role="row">
            <span role="cell" class="tbl__artist">{c.artist}</span>
            <span role="cell">{c.work}{c.note && <em class="tbl__note">{c.note}</em>}{c.label && <small>{c.label}</small>}</span>
            <span role="cell" class="tbl__role">{c.role}</span>
            <span role="cell" class="tbl__year">{c.year ?? '—'}</span>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section section--alt" id="songs">
    <div class="wrap">
      <div class="grid split songs-head">
        <div>
          <p class="eyebrow">The songs</p>
          <h2>{trackCount} songs, <em>{artistCount} artists.</em></h2>
          <p>Every song Rubino has worked on as a writer, player, producer, mixer or engineer, drawn from his own Spotify playlist. Tap a title to play it, or play the full list, which runs from pop-punk to hard rock to jazz fusion.</p>
        </div>
        <PlaylistEmbed height={380} />
      </div>
      <div class="disco">
        {discography.map((d) => (
          <div class={`disco__item ${d.headliner ? 'is-head' : ''}`}>
            <h3>{d.artist}</h3>
            <SpotifyTracks client:visible compact tracks={d.songs.map((s) => ({ title: s.title, artist: d.artist, id: s.id }))} />
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="foot">
        <h2>Want your song <em>on this list?</em></h2>
        <p>Bring Rubino your voice memo, demo or Suno track. Follow him on <a href={b.social.instagramLu} target="_blank" rel="noopener">Instagram</a>.</p>
        <DiveInCta />
      </div>
    </div>
  </section>
</Base>

<style>
  .tbl { border-top: 1px solid var(--line); }
  .tbl__head, .tbl__row { display: grid; grid-template-columns: 1.2fr 2fr 1.3fr .5fr; gap: 1.5rem; padding: 1.25rem .5rem; border-bottom: 1px solid var(--line); align-items: baseline; }
  .tbl__head { font-family: var(--font-mono); font-size: .68rem; letter-spacing: .2em; text-transform: uppercase; color: var(--muted); }
  .tbl__row { transition: background .2s; color: var(--cream-dim); }
  .tbl__row:hover { background: var(--ink-2); }
  .tbl__artist { font-family: var(--font-display); font-size: 1.35rem; color: var(--cream); }
  .is-feat .tbl__artist::before { content: '●'; color: var(--amber); font-size: .6rem; vertical-align: middle; margin-right: .6rem; }
  .tbl__note { display: block; font-style: normal; color: var(--amber); font-size: .85rem; margin-top: .2rem; }
  small { display: block; font-family: var(--font-mono); font-size: .66rem; letter-spacing: .08em; color: var(--muted); margin-top: .2rem; }
  .tbl__role { font-size: .95rem; }
  .tbl__year { font-family: var(--font-mono); font-size: .8rem; color: var(--muted); }
  @media (max-width: 760px) {
    .tbl__head { display: none; }
    .tbl__row { grid-template-columns: 1fr auto; gap: .3rem 1rem; }
    .tbl__row > span:nth-child(2), .tbl__role { grid-column: 1 / -1; }
    .tbl__year { grid-row: 1; grid-column: 2; }
  }
  .foot { margin: 0; }
  .songs-head { margin-bottom: 3.5rem; align-items: start; }
  .disco { columns: 3 260px; column-gap: 2.5rem; }
  .disco__item { break-inside: avoid; padding: 1.2rem 0; border-top: 1px solid var(--line); }
  .disco__item h3 { font-size: 1.25rem; margin-bottom: .4rem; }
  .is-head h3 { color: var(--amber); }
  .disco ul { list-style: none; padding: 0; margin: 0; }
  .disco li { color: var(--cream-dim); font-size: .92rem; line-height: 1.7; }
</style>
