---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import DiveInCta from '../components/DiveInCta.astro';
import { business as b } from '../data/site';
const schema = [{
  '@context': 'https://schema.org', '@type': 'Service', serviceType: 'Film and television music scoring',
  name: 'Film, TV & Documentary Scoring', provider: { '@id': `${b.url}/#studio` },
}];
---
<Base
  title="Film & TV Scoring Composer in St. Augustine, FL | The Fish Tank"
  description="Original music for film, TV and documentary, composed and recorded to picture by Lucio Rubino at The Fish Tank Recordings in St. Augustine, Florida."
  schema={schema}
  crumbs={[{ name: 'Film & TV Scoring', path: '/film-tv-scoring/' }]}
>
  <PageHero eyebrow="Our work · Scoring" title="Your picture is unique. <em>Its sound should be too.</em>"
    lede="Score does a lot of a scene’s emotional work. Rubino composes and records original music for television, film and documentary, written to picture and to the director’s intent." />
  <section class="section">
    <div class="wrap grid split">
      <div class="prose">
        <h2>Selected work</h2>
        <ul class="work">
          <li><span>TV series</span><strong>Artifact or Fiction</strong></li>
          <li><span>TV series</span><strong>Getting Fresh</strong></li>
        </ul>
        <blockquote>“Lu is arguably the most talented artist/composer in NE Florida.”<cite>Michael Arbuthnot, TV host & producer</cite></blockquote>
        <p>Scores run from full orchestral arrangements to spare acoustic cues, and everything is composed, performed and mixed in-house. That keeps turnaround short, even when the brief is loose.</p>
        <DiveInCta />
      </div>
      <img class="img img--wide" src="/images/outboard-wide.webp" alt="Outboard processing gear in The Fish Tank control room" width="1600" height="899" loading="lazy" decoding="async" />
    </div>
  </section>
</Base>

<style>
  .work { list-style: none; padding: 0; border-top: 1px solid var(--line); }
  .work li { display: flex; justify-content: space-between; padding: 1rem 0; border-bottom: 1px solid var(--line); }
  .work span { font-family: var(--font-mono); font-size: .7rem; letter-spacing: .15em; text-transform: uppercase; color: var(--muted); }
  .work strong { font-family: var(--font-display); font-size: 1.3rem; font-weight: 400; }
  blockquote { margin: 2.5rem 0; font-family: var(--font-display); font-size: 1.6rem; font-style: italic; line-height: 1.35; }
  cite { display: block; font-family: var(--font-mono); font-style: normal; font-size: .7rem; letter-spacing: .12em; text-transform: uppercase; color: var(--muted); margin-top: .8rem; }
</style>
