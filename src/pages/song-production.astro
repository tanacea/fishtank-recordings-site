---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import TrackList from '../components/TrackList.vue';
import Faq from '../components/Faq.astro';
import Testimonials from '../components/Testimonials.astro';
import { tracks, business as b } from '../data/site';

const faq = [
  { q: 'Can I come in with just a voice memo?', a: 'Yes. Many Fish Tank records started as phone recordings. Rubino helps shape structure, melody, lyric and arrangement before anything is tracked.' },
  { q: 'Who plays the instruments?', a: 'Rubino is a multi-instrumentalist: guitars, bass, keys and drums, plus programming and sound design. The studio also keeps basses, guitars, a Dobro, a banjo, an upright bass and a Medicine Man drum kit on hand. Artists with a band are welcome to bring it.' },
  { q: 'Do you help with songwriting?', a: 'Yes. Rubino is a co-writer on RED’s Rated R and co-wrote StorySide:B’s BMI-recognized “Be Still.” Co-writing is part of full-song production whenever the song calls for it.' },
  { q: 'What do I get at the end?', a: 'Mixed and mastered tracks ready for streaming and radio. Ask about instrumentals and alternate versions for your project.' },
];
const schema = [{
  '@context': 'https://schema.org',
  '@type': 'Service',
  serviceType: 'Music production',
  name: 'Full-Song Music Production',
  provider: { '@id': `${b.url}/#studio` },
  areaServed: ['St. Augustine, FL', 'Jacksonville, FL', 'Florida', 'Nashville, TN', 'United States'],
  description: 'Complete song production: songwriting, arrangement, tracking, mixing and mastering with producer Lucio Rubino.',
}];
---
<Base
  title="Full-Song Music Production in St. Augustine, FL | The Fish Tank"
  description="From demo to finished record. Songwriting, arrangement, tracking, mixing and mastering with producer Lucio Rubino (Paramore, RED, Grey Daze)."
  schema={schema}
  crumbs={[{ name: 'Song Production', path: '/song-production/' }]}
>
  <PageHero eyebrow="Our work · Song production" title="Full-song production, <em>demo to master.</em>"
    lede="Full-song production is The Fish Tank’s core business. Rubino takes a song from rough demo to finished master: the writing and arrangement, the players, the sound, the mix. One producer stays on the record from start to finish.">
    <div style="margin-top:2rem"><a href="/contact/" class="btn">Talk about your songs →</a></div>
  </PageHero>

  <section class="section">
    <div class="wrap grid split">
      <div class="prose">
        <h2>Why one producer <em>instead of studio time.</em></h2>
        <p>Booking studio time buys an engineer and a clock. Full-song production brings in a multi-instrumentalist and programmer who has <strong>played on a Platinum album</strong>, <strong>co-written with a Grammy-nominated band</strong> and <strong>fronted a label act</strong>, and who stays with the song until it is finished.</p>
        <p>Rubino’s credits span pop-punk, hard rock, singer-songwriter records, Christian radio and jazz fusion. That range shows up in the decisions: when a chorus needs more lift, when a song wants a different key, and when the right call is to take parts away.</p>
        <h3>What's included</h3>
        <ul>
          <li>Song consultation, structure and co-writing</li>
          <li>Pre-production and arrangement</li>
          <li>Vocal production and coaching</li>
          <li>Guitars, bass, keys, drums and programming performed by Rubino</li>
          <li>Symphonic and string arrangements when the song wants them</li>
          <li>Tracking through the SSL Origin and FLEA U47</li>
          <li>Editing, mixing and mastering</li>
        </ul>
      </div>
      <div class="photo">Photo: tracking in the live room (to shoot)</div>
    </div>
  </section>

  <section class="section section--alt">
    <div class="wrap">
      <p class="eyebrow">Listen</p>
      <h2>Selected productions <em>from the studio.</em></h2>
      <TrackList client:visible tracks={tracks} />
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <Testimonials limit={2} />
    </div>
  </section>

  <section class="section section--alt">
    <div class="wrap"><Faq items={faq} title="Production questions" /></div>
  </section>
</Base>
