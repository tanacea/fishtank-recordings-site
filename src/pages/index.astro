---
import Base from '../layouts/Base.astro';
import Testimonials from '../components/Testimonials.astro';
import Faq from '../components/Faq.astro';
import PlaylistEmbed from '../components/PlaylistEmbed.astro';
import Anywhere from '../components/Anywhere.astro';
import DiveIn from '../components/DiveIn.astro';
import DiveInCta from '../components/DiveInCta.astro';
import BeforeAfter from '../components/BeforeAfter.astro';
import { trackCount } from '../data/discography';
import { marquee, business as b, cta, packagesLine, genresLine } from '../data/site';

const faq = [
  { q: 'How do I get a quote?', a: `Book a free Dive In visit, in person at the studio or on Google Meet. Rubino listens to your song, talks through your goals and lays out a plan. ${packagesLine}` },
  { q: 'Can you produce my song if I don’t live near St. Augustine?', a: 'Yes. Remote production is a big part of the work. Send a voice memo, a demo or a Suno track, talk through your goals, and Rubino builds the full production. You give feedback along the way and receive a finished master.' },
  { q: 'What kinds of music do you produce?', a: `${genresLine} Rubino’s credits run from pop-punk and hard rock to Christian radio and jazz fusion.` },
  { q: 'What does full-song production include?', a: 'Everything it takes to turn a song into a finished record: song and arrangement development, pre-production, tracking (vocals, guitars, bass, drums, keys), programming, vocal coaching, editing, mixing and mastering.' },
  { q: 'Do I need a band to record a full production?', a: 'No. Rubino is a multi-instrumentalist who covers guitars, bass, keys, drums and programming on his productions, so many artists arrive with only a voice and a guitar.' },
  { q: 'Where is the studio?', a: `The Fish Tank Recordings is at ${b.street} in St. Augustine, Florida: an elevated studio down a private drive, overlooking the marsh, about 45 minutes from Jacksonville. Sessions are by appointment.` },
];

const schema = [{
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: b.name,
  url: b.url,
}];
---
<Base
  title="Music Producer · Remote or St. Augustine, FL | The Fish Tank Recordings"
  description="Bring your song, leave with a record. Producer Lucio Rubino (Paramore, RED, STARSET, Grey Daze) produces, mixes and masters, in St. Augustine, FL or remotely."
  schema={schema}
>
  <!-- HERO -->
  <section class="hero">
    <div class="hero__bg" role="img" aria-label="The Fish Tank Recordings control room: SSL console, monitors and a wall of guitars"></div>
    <div class="wrap hero__grid">
      <div>
        <p class="eyebrow">Full-song production · In studio or remote · Since {b.founded}</p>
        <h1>Bring your song. <em>Leave with a record.</em></h1>
        <p class="lede">Lucio Rubino writes, arranges, plays, records, mixes and masters, turning your song into a finished record. His credits include Paramore’s Platinum debut, RED, STARSET and Grey Daze.</p>
        <p class="hero__genres">{genresLine}</p>
        <div class="hero__ctas">
          <a href={cta.href} class="btn" target="_blank" rel="noopener" data-cta="divein">{cta.label} →</a>
          <a href="#listen" class="btn btn--ghost">▶ Listen</a>
        </div>
        <p class="hero__micro">{cta.micro} In person at the studio or on Google Meet.</p>
      </div>
      <div class="vu" aria-hidden="true">
        <div class="vu__face">
          <span class="vu__label">VU</span>
          <div class="vu__scale"><i>-20</i><i>-10</i><i>-5</i><i>0</i><i class="hot">+3</i></div>
          <div class="vu__needle"></div>
          <span class="vu__brand">THE FISH TANK RECORDINGS · CH 1</span>
        </div>
        <div class="vu__face">
          <span class="vu__label">VU</span>
          <div class="vu__scale"><i>-20</i><i>-10</i><i>-5</i><i>0</i><i class="hot">+3</i></div>
          <div class="vu__needle vu__needle--b"></div>
          <span class="vu__brand">THE FISH TANK RECORDINGS · CH 2</span>
        </div>
      </div>
    </div>
    <div class="marquee" aria-label="Artists Lucio Rubino has worked with">
      <div class="marquee__track">
        {[...marquee, ...marquee].map((m, i) => <span aria-hidden={i >= marquee.length ? 'true' : undefined}>{m}</span>)}
      </div>
    </div>
  </section>

  <Anywhere alt />

  <!-- PLATINUM FEATURE -->
  <section class="plat">
    <div class="wrap plat__grid">
      <div class="plat__plaque" aria-hidden="true">
        <svg viewBox="0 0 320 320" class="plat__disc">
          <defs>
            <radialGradient id="pd" cx="50%" cy="50%" r="50%">
              <stop offset="0%" stop-color="#f4f4f2"/><stop offset="38%" stop-color="#c9ccd1"/>
              <stop offset="62%" stop-color="#e9eaec"/><stop offset="100%" stop-color="#9aa0a8"/>
            </radialGradient>
            <linearGradient id="ps" x1="0" y1="0" x2="1" y2="1">
              <stop offset="0%" stop-color="#fff" stop-opacity=".75"/><stop offset="45%" stop-color="#fff" stop-opacity="0"/>
            </linearGradient>
          </defs>
          <circle cx="160" cy="160" r="150" fill="url(#pd)"/>
          <g fill="none" stroke="#7d838b" stroke-opacity=".35">
            <circle cx="160" cy="160" r="135"/><circle cx="160" cy="160" r="122"/><circle cx="160" cy="160" r="109"/>
            <circle cx="160" cy="160" r="96"/><circle cx="160" cy="160" r="83"/><circle cx="160" cy="160" r="70"/>
          </g>
          <circle cx="160" cy="160" r="52" fill="#1b1611"/>
          <circle cx="160" cy="160" r="50" fill="none" stroke="var(--amber)" stroke-width="1.5"/>
          <text x="160" y="153" text-anchor="middle" font-family="JetBrains Mono, monospace" font-size="9" letter-spacing="2" fill="var(--amber)">RIAA</text>
          <text x="160" y="172" text-anchor="middle" font-family="Fraunces, Georgia, serif" font-style="italic" font-size="17" fill="#efe6d8">Platinum</text>
          <circle cx="160" cy="160" r="4" fill="#0e0c0a"/>
          <circle cx="160" cy="160" r="150" fill="url(#ps)"/>
        </svg>
      </div>
      <div>
        <p class="eyebrow">RIAA Platinum · August 2025</p>
        <h2>The bass line under <em>Paramore’s Platinum debut.</em></h2>
        <p class="lede">When Paramore cut <em>All We Know Is Falling</em> in 2004 and 2005, the band was between bassists. Rubino, then fronting StorySide:B, filled the chair and played on every track except “Here We Go Again.” The album never reached the Billboard 200 on release. Twenty years later, in August 2025, the RIAA certified it <strong>Platinum</strong>, and lead single “Pressure” has passed a million units as well.</p>
        <p>On that record he was the bassist. On most of his others, he plays nearly everything, then programs, produces and mixes the result.</p>
        <div class="plat__stats">
          <div><strong>Platinum</strong><span>Album · RIAA, 2025</span></div>
          <div><strong>Platinum</strong><span>“Pressure” single</span></div>
          <div><strong>All but 1</strong><span>Tracks with Rubino on bass</span></div>
        </div>
      </div>
    </div>
  </section>

  <!-- PROOF -->
  <section class="section">
    <div class="wrap">
      <p class="eyebrow">Selected credits</p>
      <h2>A résumé that crosses <em>genres and decades.</em></h2>
      <div class="grid grid-2 proof">
        <a class="card" href="/credits/#songs"><span class="num">STARSET · 8 SONGS</span><h3>Eight songs with <em>STARSET.</em></h3><p>Rubino worked on eight tracks by the Columbus, Ohio, hard-rock act, among them “Trials,” “Manifest,” “Echo” and “Faultline.”</p></a>
        <a class="card" href="/credits/"><span class="num">RED · 2023</span><h3>Co-writing for <em>RED.</em></h3><p>He co-wrote “Still Bleeding,” where he also plays bass, and “Your Devil Is a Ghost” for <em>Rated R</em> (2023), the eighth studio album from the Grammy-nominated Nashville band.</p></a>
        <a class="card" href="/credits/"><span class="num">GREY DAZE · 2020</span><h3>Producer, Grey Daze’s <em>“In Time.”</em></h3><p>Rubino produced “In Time” for <em>Amends</em> (2020), the Loma Vista album that rebuilt Chester Bennington’s pre-Linkin Park band around his original vocals. It reached No. 9 on Billboard’s Top Rock Albums chart.</p></a>
        <a class="card" href="/credits/"><span class="num">STORYSIDE:B · 2008</span><h3>“Be Still” and <em>the BMI list.</em></h3><p>As frontman of Gotee Records act StorySide:B, he co-wrote “Be Still,” which BMI counted among the five most-played songs on Christian radio in 2008.</p></a>
      </div>
      <p class="proof__more"><a href="/credits/">Full credits →</a></p>
    </div>
  </section>

  <BeforeAfter alt />

  <!-- LISTEN -->
  <section class="section" id="listen">
    <div class="wrap grid split listen">
      <div>
        <p class="eyebrow">Listen · On Spotify</p>
        <h2>Songs Lucio Rubino <em>had a hand in.</em></h2>
        <p class="lede">{trackCount} songs he has written, played on or produced, from Paramore and STARSET to RED, Grey Daze, Larry Coryell and a long list of independent artists.</p>
        <a href="/credits/#songs" class="btn btn--ghost">Credits, song by song →</a>
      </div>
      <PlaylistEmbed height={452} />
    </div>
  </section>

  <!-- SERVICES -->
  <section class="section">
    <div class="wrap">
      <p class="eyebrow">Services</p>
      <h2>Every stage of a record, <em>under one roof.</em></h2>
      <p class="lede">{genresLine}</p>
      <div class="grid grid-3 svc">
        <a class="card" href="/song-production/"><span class="num">01</span><h3>Full-Song Production</h3><p>Co-writing, arranging, playing and producing complete songs, from a voice memo or Suno demo to a finished master. Quick turnarounds.</p></a>
        <a class="card" href="/services/#assessment"><span class="num">02</span><h3>Artist Assessments</h3><p>Not sure where to start? Get a professional assessment of your music and a plan for what’s next.</p></a>
        <a class="card" href="/services/#recording"><span class="num">03</span><h3>Recording</h3><p>High-resolution multitrack recording, up to 96 tracks, through an SSL Origin console.</p></a>
        <a class="card" href="/services/#mixing"><span class="num">04</span><h3>Mixing & Mastering</h3><p>Mixes with space and impact, and masters that hold up next to commercial releases.</p></a>
        <a class="card" href="/services/#arrangement"><span class="num">05</span><h3>Arrangement & Coaching</h3><p>Orchestral arrangements, plus vocal and instrument coaching during sessions.</p></a>
        <a class="card" href="/film-tv-scoring/"><span class="num">06</span><h3>Film, TV & Commercial</h3><p>Original music for picture, television and radio campaigns, written to the brief.</p></a>
      </div>
      <div class="pkg">
        <p class="pkg__line">{packagesLine}</p>
        <DiveInCta />
      </div>
    </div>
  </section>

  <DiveIn />

  <!-- LUCIO -->
  <section class="section section--alt">
    <div class="wrap grid split">
      <img class="img" src="/images/lu-console.webp" alt="Lucio Rubino at the console in The Fish Tank Recordings control room" width="800" height="1000" loading="lazy" decoding="async" />
      <div>
        <p class="eyebrow">The producer</p>
        <h2>Lucio Rubino, <em>three decades in.</em></h2>
        <p>Rubino’s first tour came in 1998, playing bass for A Flock of Seagulls. Since then he has signed to EMI as a member of Monkey the Fish, fronted StorySide:B on Gotee Records, played on Paramore’s Platinum debut, toured Europe with RED and produced for jazz guitarist Larry Coryell. He opened The Fish Tank Recordings in {b.founded}.</p>
        <p>He plays nearly every instrument heard on a modern record, from guitars, bass and keys to drums, and he is as fluent in programming and sound design as he is behind a console. The through line is the song, and his credits run from St. Augustine to Nashville.</p>
        <a href="/lucio-rubino/" class="btn btn--ghost">Full bio →</a>
      </div>
    </div>
  </section>

  <!-- SANCTUARY -->
  <section class="sanct">
    <div class="sanct__img" role="img" aria-label="The Fish Tank Recordings live room, with amps, a drum kit and a window to the outdoors" style="background-image: linear-gradient(180deg, rgba(14,12,10,.15), rgba(14,12,10,.9) 82%), url(/images/live-room-wide.webp)"></div>
    <div class="wrap sanct__copy">
      <p class="eyebrow">The studio</p>
      <h2>An elevated room <em>above the marsh.</em></h2>
      <p class="lede">The Fish Tank Recordings sits at the end of a private drive in St. Augustine, Fla., with a wide view of the marsh and a large deck where artists step out between takes. It is built for long, unhurried sessions, the kind that are hard to find in a rented room on the clock.</p>
      <a href="/studio/" class="btn btn--ghost">Tour the studio →</a>
    </div>
  </section>

  <!-- TESTIMONIALS -->
  <section class="section section--alt">
    <div class="wrap">
      <p class="eyebrow">Testimonials</p>
      <h2>What artists say <em>about the room.</em></h2>
      <Testimonials limit={2} />
      <p class="proof__more"><a href="/testimonials/">More testimonials →</a></p>
    </div>
  </section>

  <!-- LOCATION + FAQ -->
  <section class="section">
    <div class="wrap grid split">
      <div>
        <Faq items={faq} />
        <div class="faq__cta">
          <p>{packagesLine}</p>
          <DiveInCta />
        </div>
      </div>
      <div class="loc card">
        <p class="eyebrow">Location</p>
        <h3>{b.street}<br />{b.city}, {b.region} {b.postal}</h3>
        <p>At the end of a private drive overlooking the St. Augustine marsh, about 45 minutes south of Jacksonville. Sessions by appointment.</p>
        <p><a href={`tel:${b.phoneE164}`}>{b.phone}</a><br /><a href={`mailto:${b.email}`}>{b.email}</a></p>
        <a class="btn btn--ghost" target="_blank" rel="noopener" href="https://www.google.com/maps/search/?api=1&query=24+Althea+Street+St+Augustine+FL+32084">Open in Maps ↗</a>
      </div>
    </div>
  </section>
</Base>

<style>
  .hero { padding-top: clamp(3.5rem, 8vw, 6.5rem); position: relative; overflow: hidden; isolation: isolate; }
  /* studio photo behind the hero, toned down so the copy stays readable */
  .hero__bg { position: absolute; inset: 0; z-index: -2;
    background: url(/images/hero-studio.webp) center 42% / cover no-repeat;
    opacity: .72; filter: saturate(.9) contrast(1.05); transform: scale(1.04);
    animation: drift 30s ease-in-out infinite alternate; }
  .hero::before { content: ''; position: absolute; inset: 0; z-index: -1;
    background:
      linear-gradient(90deg, rgba(14,12,10,.93) 0%, rgba(14,12,10,.84) 45%, rgba(14,12,10,.5) 72%, rgba(14,12,10,.55) 100%),
      linear-gradient(180deg, rgba(14,12,10,.35) 0%, transparent 30%, rgba(14,12,10,.9) 100%),
      radial-gradient(ellipse 45% 55% at 80% 35%, rgba(240,164,58,.14), transparent 70%); }
  @keyframes drift { to { transform: scale(1.1) translate(-1.5%, -1%); } }
  @media (max-width: 959px) {
    .hero::before { background: linear-gradient(180deg, rgba(14,12,10,.62) 0%, rgba(14,12,10,.86) 45%, rgba(14,12,10,.95) 100%); }
  }
  .hero__grid { display: grid; gap: 3rem; align-items: center; padding-bottom: 4.5rem; }
  @media (min-width: 960px) { .hero__grid { grid-template-columns: 1.35fr .65fr; } }
  .hero h1 { max-width: 15ch; }
  .hero__ctas { display: flex; gap: 1rem; flex-wrap: wrap; margin-top: 2rem; }
  .hero__genres { font-family: var(--font-mono); font-size: .78rem; letter-spacing: .14em; text-transform: uppercase; color: var(--amber); margin: 1.2rem 0 0; }
  .hero__micro { margin: .9rem 0 0; font-family: var(--font-mono); font-size: .7rem; letter-spacing: .12em; text-transform: uppercase; color: var(--muted); }
  .listen { align-items: center; }
  .pkg { margin-top: 3rem; padding-top: 2.5rem; border-top: 1px solid var(--line); display: flex; flex-wrap: wrap; gap: 1.5rem 3rem; align-items: center; justify-content: space-between; }
  .pkg__line { margin: 0; font-family: var(--font-display); font-size: clamp(1.2rem, 2vw, 1.5rem); color: var(--cream); max-width: 34ch; }
  .faq__cta { margin-top: 2rem; }
  .faq__cta p { color: var(--cream); }

  /* VU meters */
  .vu { display: grid; gap: 1.1rem; }
  .vu__face {
    position: relative; height: 150px; border-radius: 6px; overflow: hidden;
    background: radial-gradient(ellipse at 50% 120%, #f6d9a0, #e9b867 55%, #b9822f);
    box-shadow: inset 0 0 0 6px #1b1611, inset 0 0 30px rgba(0,0,0,.45), 0 0 50px rgba(240,164,58,.18);
  }
  .vu__label { position: absolute; top: 14px; left: 18px; font-family: var(--font-display); font-style: italic; color: #2a1d0e; font-size: 1.3rem; }
  .vu__brand { position: absolute; bottom: 12px; width: 100%; text-align: center; font-family: var(--font-mono); font-size: .55rem; letter-spacing: .25em; color: #3a2a15; }
  .vu__scale { position: absolute; top: 40px; left: 12%; right: 12%; display: flex; justify-content: space-between; font-family: var(--font-mono); font-size: .62rem; color: #2a1d0e; }
  .vu__scale .hot { color: #a32c18; }
  .vu__needle { position: absolute; bottom: -20px; left: 50%; width: 2px; height: 140px; background: #1a120a; transform-origin: bottom center; animation: needle 2.6s ease-in-out infinite; }
  .vu__needle--b { animation-duration: 3.1s; animation-delay: -.8s; }
  @keyframes needle {
    0% { transform: rotate(-42deg); } 18% { transform: rotate(8deg); } 30% { transform: rotate(-12deg); }
    48% { transform: rotate(22deg); } 62% { transform: rotate(-4deg); } 80% { transform: rotate(14deg); } 100% { transform: rotate(-42deg); }
  }
  @media (max-width: 959px) { .vu { grid-template-columns: 1fr 1fr; } .vu__face { height: 120px; } }

  .marquee { border-block: 1px solid var(--line); overflow: hidden; background: var(--ink-2); }
  .marquee__track { display: flex; gap: 4rem; padding: 1.3rem 0; width: max-content; animation: scroll 40s linear infinite; }
  .marquee span { font-family: var(--font-display); font-style: italic; font-size: 1.6rem; color: var(--cream-dim); white-space: nowrap; }
  .marquee span::after { content: '✦'; color: var(--amber); font-style: normal; font-size: .9rem; margin-left: 4rem; }
  @keyframes scroll { to { transform: translateX(-50%); } }

  .plat { padding: clamp(4rem, 9vw, 7rem) 0; border-bottom: 1px solid var(--line);
    background: radial-gradient(ellipse 50% 70% at 20% 50%, rgba(220,224,230,.10), transparent 70%), var(--ink); }
  .plat__grid { display: grid; gap: 3rem; align-items: center; }
  @media (min-width: 900px) { .plat__grid { grid-template-columns: .8fr 1.2fr; gap: 5rem; } }
  .plat__plaque { padding: 1.6rem; border: 1px solid var(--line); border-radius: 6px; max-width: 420px; margin-inline: auto;
    background: linear-gradient(160deg, #241d16, #0f0d0b); box-shadow: 0 30px 80px rgba(0,0,0,.5), inset 0 0 0 8px #15110d; }
  .plat__disc { width: 100%; height: auto; display: block; animation: spin 24s linear infinite; filter: drop-shadow(0 10px 30px rgba(220,224,230,.18)); }
  @keyframes spin { to { transform: rotate(360deg); } }
  .plat h2 em { color: #dfe3e8; }
  .plat__stats { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 1rem; margin-top: 2rem; border-top: 1px solid var(--line); padding-top: 1.5rem; }
  .plat__stats strong { display: block; font-family: var(--font-display); font-size: clamp(1.3rem, 2.4vw, 1.9rem); font-weight: 400; color: #e6e9ed; }
  .plat__stats span { font-family: var(--font-mono); font-size: .66rem; letter-spacing: .12em; text-transform: uppercase; color: var(--muted); }
  .proof .card, .svc .card { color: inherit; }
  .proof .card:hover, .svc .card:hover { transform: translateY(-3px); border-color: var(--amber-deep); }
  .proof h3 em { color: var(--amber); }
  .proof__more { margin-top: 2rem; font-family: var(--font-mono); font-size: .8rem; letter-spacing: .1em; text-transform: uppercase; }

  .steps { list-style: none; margin: 0; padding: 0; display: grid; gap: 1.5rem; }
  .steps li { display: grid; grid-template-columns: 3rem 1fr; gap: 1rem; padding-bottom: 1.5rem; border-bottom: 1px solid var(--line); }
  .steps li:last-child { border-bottom: 0; }
  .steps span { font-family: var(--font-mono); color: var(--amber); font-size: .85rem; padding-top: .35rem; }
  .steps h3 { margin-bottom: .3rem; }
  .steps p { margin: 0; }

  .listen__head { display: flex; justify-content: space-between; align-items: flex-end; gap: 1.5rem; flex-wrap: wrap; margin-bottom: 2rem; }
  .svc { margin-top: 2.5rem; }
  .sp-head { margin-top: 4.5rem; align-items: start; }
  .sp-title { font-size: clamp(1.6rem, 2.6vw, 2.1rem); }
  .sp-title em { color: var(--amber); }
  .loc h3 { font-size: 1.7rem; }
  .sanct { position: relative; border-block: 1px solid var(--line); }
  .sanct__img { min-height: 600px; width: 100%; background-size: cover; background-position: center 40%; }
  .sanct__copy { position: absolute; left: 0; right: 0; bottom: clamp(2.5rem, 6vw, 4.5rem); }
  .sanct__copy h2 { max-width: 18ch; }
  @media (max-width: 700px) { .sanct__img { min-height: 640px; } }
</style>
