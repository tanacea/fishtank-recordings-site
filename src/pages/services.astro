---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import { business as b } from '../data/site';

const services = [
  { id: 'production', title: 'Full-Song Production', href: '/song-production/', body: 'Songwriting, structure, arrangement, instrumentation, performance, vocal arrangement, coaching and lyrics, taken all the way to a release-ready record.' },
  { id: 'recording', title: 'Hi-Definition Multitrack Recording', body: 'Up to 96 tracks of high-resolution detail on Avid Pro Tools HD and industry-standard converters, through an SSL Origin console and a mic locker led by a FLEA U47 Next and Royer and AEA ribbons. The detail of a performance is captured as it happened.' },
  { id: 'mixing', title: 'Mixing', body: 'Balance, compression and EQ so every part has its own space and the record lands as a whole. Analog color comes from a Shadow Hills Dual Vandergraph, Elysia Nvelope, API 512b and a pair of Empirical Labs Distressors.' },
  { id: 'mastering', title: 'Mastering', body: 'The last step before release: flow, balance and loudness, set with hardware such as the A-Designs Hammer tube EQ and current software, for a master that is full, warm and clear. Artists are walked through the process.' },
  { id: 'arrangement', title: 'Symphonic Arrangement', body: 'Orchestral arrangements for strings, woodwinds, brass and orchestral percussion, built from top-tier sample libraries.' },
  { id: 'coaching', title: 'Vocal & Instrument Coaching', body: 'Vocal and instrument coaching during sessions from a working frontman and multi-instrumentalist.' },
  { id: 'scoring', title: 'Film, TV & Documentary Scoring', href: '/film-tv-scoring/', body: 'Original music composed and recorded to picture, written to serve the scene.' },
  { id: 'commercial', title: 'Commercial & Advertising Music', href: '/commercial-music/', body: 'Custom music for TV and radio campaigns, written to the brief and delivered ready for broadcast.' },
  { id: 'voiceover', title: 'Voice-Over & Spoken Word', body: 'Voice-over, oral history recording, sound effects and Foley for video, podcasts and archives.' },
  { id: 'live', title: 'On-Location Recording', body: 'On-location 24-track live recording and sound reinforcement for concerts and events.' },
  { id: 'consulting', title: 'Music Business Consultation', body: 'Practical advice on releasing music, positioning and building a career, from someone who has signed deals, toured and released records.' },
];
const schema = [{
  '@context': 'https://schema.org',
  '@type': 'OfferCatalog',
  name: 'Studio services',
  itemListElement: services.map((s) => ({ '@type': 'Offer', itemOffered: { '@type': 'Service', name: s.title, provider: { '@id': `${b.url}/#studio` } } })),
}];
---
<Base
  title="Recording, Mixing & Mastering Services in St. Augustine | The Fish Tank"
  description="Recording, mixing, mastering, symphonic arrangement, vocal coaching, voice-over and on-location recording at The Fish Tank Recordings in St. Augustine, FL."
  schema={schema}
  crumbs={[{ name: 'Services', path: '/services/' }]}
>
  <PageHero eyebrow="Services" title="Recording, mixing, mastering <em>and everything around it.</em>"
    lede="From full productions to a single mix, every project runs through the same room and the same producer." />

  <section class="section">
    <div class="wrap svc-list">
      {services.map((s, i) => (
        <article id={s.id} class="svc">
          <span class="num">{String(i + 1).padStart(2, '0')}</span>
          <div>
            <h2>{s.title}</h2>
            <p>{s.body}</p>
            {s.href && <a href={s.href}>Learn more →</a>}
          </div>
        </article>
      ))}
      <p class="gearlink">See everything in the room on the <a href="/gear/">gear list →</a></p>
    </div>
  </section>
</Base>

<style>
  .svc { display: grid; grid-template-columns: 4rem 1fr; gap: 1.5rem; padding: 2.5rem 0; border-bottom: 1px solid var(--line); scroll-margin-top: 100px; }
  .svc h2 { font-size: clamp(1.6rem, 3vw, 2.2rem); }
  .svc p { max-width: 65ch; }
  .num { font-family: var(--font-mono); color: var(--amber); font-size: .9rem; padding-top: .6rem; }
  .svc a { font-family: var(--font-mono); font-size: .78rem; letter-spacing: .1em; text-transform: uppercase; }
  .gearlink { margin-top: 2.5rem; }
</style>
