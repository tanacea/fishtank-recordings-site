---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import Testimonials from '../components/Testimonials.astro';
---
<Base
  title="Testimonials: Artists on The Fish Tank Recordings"
  description="What artists, songwriters and producers say about recording with Lucio Rubino at The Fish Tank Recordings in St. Augustine, FL."
  crumbs={[{ name: 'Testimonials', path: '/testimonials' }]}
>
  <PageHero eyebrow="About · Testimonials" title="From the people <em>who’ve been in the room.</em>" />
  <section class="section"><div class="wrap"><Testimonials /></div></section>
  <section class="section section--alt"><div class="wrap" style="text-align:center">
    <h2>Your song <em>could be next.</em></h2><a class="btn" href="/contact">Start your record →</a>
  </div></section>
</Base>
