---
// Remote production: five steps, plus the Suno line and the fly-in option.
import DiveInCta from './DiveInCta.astro';
interface Props { alt?: boolean }
const { alt = false } = Astro.props;
const steps = [
  ['Send your song', 'A voice memo, a rough demo or a Suno track. Whatever you have is enough to start.'],
  ['We talk about your goals', 'The sound you hear in your head, the records you want to stand beside and when you want it out.'],
  ['Rubino builds the full production', 'He writes and arranges the parts, plays the instruments, programs, records and mixes.'],
  ['You give feedback', 'You hear the record as it takes shape and steer it until it sounds like you.'],
  ['You get your finished master', 'Mixed, mastered and ready for streaming, radio and release.'],
];
---
<section class:list={['section', { 'section--alt': alt }]} id="anywhere">
  <div class="wrap">
    <div class="grid split aw__head">
      <div>
        <p class="eyebrow">Remote production · Quick turnarounds</p>
        <h2>Work with Rubino <em>from anywhere.</em></h2>
      </div>
      <p class="lede">Remote production is a big part of the work at The Fish Tank Recordings. Send the song from wherever you are, and Rubino turns it into a finished, release-ready record.</p>
    </div>
    <ol class="aw__steps">
      {steps.map(([h, p], i) => (
        <li><span>{String(i + 1).padStart(2, '0')}</span><h3>{h}</h3><p>{p}</p></li>
      ))}
    </ol>
    <div class="aw__foot">
      <div class="aw__notes">
        <p class="aw__suno"><strong>Got a Suno demo you love?</strong> Let’s turn it into a real record you can release.</p>
        <p class="aw__fly">Or fly in and record above the St. Augustine marsh.</p>
      </div>
      <DiveInCta />
    </div>
  </div>
</section>

<style>
  .aw__head { align-items: end; margin-bottom: 3rem; }
  .aw__steps { list-style: none; padding: 0; margin: 0 0 3rem; display: grid; gap: 1px; background: var(--line); border: 1px solid var(--line); border-radius: 6px; overflow: hidden; }
  @media (min-width: 760px) { .aw__steps { grid-template-columns: repeat(5, 1fr); } }
  .aw__steps li { background: var(--ink-2); padding: 1.6rem 1.4rem; }
  .section--alt .aw__steps li { background: var(--ink); }
  .aw__steps span { font-family: var(--font-mono); color: var(--amber); font-size: .8rem; }
  .aw__steps h3 { font-size: 1.2rem; margin: .8rem 0 .5rem; }
  .aw__steps p { margin: 0; font-size: .95rem; }
  .aw__foot { display: grid; gap: 2rem; align-items: center; }
  @media (min-width: 900px) { .aw__foot { grid-template-columns: 1.2fr 1fr; } }
  .aw__notes p { margin: 0 0 .6rem; }
  .aw__suno { font-size: 1.15rem; color: var(--cream); }
  .aw__suno strong { color: var(--amber); font-weight: 500; }
  .aw__fly { font-family: var(--font-display); font-style: italic; font-size: 1.3rem; color: var(--cream-dim); }
</style>
