---
import { testimonials } from '../data/site';
interface Props { limit?: number }
const { limit } = Astro.props;
const list = limit ? testimonials.slice(0, limit) : testimonials;
---
<div class="grid grid-2 tst">
  {list.map((t) => (
    <figure class="card">
      <blockquote>“{t.quote}”</blockquote>
      <figcaption><strong>{t.name}</strong><span>{t.role}</span></figcaption>
    </figure>
  ))}
</div>

<style>
  .tst figure { margin: 0; display: flex; flex-direction: column; justify-content: space-between; gap: 1.5rem; }
  blockquote { margin: 0; font-family: var(--font-display); font-size: 1.35rem; line-height: 1.4; color: var(--cream); font-style: italic; }
  figcaption { display: flex; flex-direction: column; gap: .2rem; }
  figcaption span { font-family: var(--font-mono); font-size: .7rem; letter-spacing: .12em; text-transform: uppercase; color: var(--muted); }
</style>
