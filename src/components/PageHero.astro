---
interface Props { eyebrow: string; title: string; lede?: string }
const { eyebrow, title, lede } = Astro.props;
---
<section class="ph">
  <div class="wrap">
    <p class="eyebrow">{eyebrow}</p>
    <h1 set:html={title} />
    {lede && <p class="lede">{lede}</p>}
    <slot />
  </div>
</section>

<style>
  .ph { padding: clamp(4.5rem, 10vw, 8rem) 0 clamp(3rem, 6vw, 4.5rem); border-bottom: 1px solid var(--line);
    background: radial-gradient(ellipse 60% 80% at 85% 0%, rgba(240,164,58,.12), transparent 70%); }
  h1 { max-width: 16ch; font-size: clamp(2.4rem, 5.5vw, 4.6rem); }
</style>
