---
import Logo from './Logo.astro';
import DiveInCta from './DiveInCta.astro';
import { business as b, packagesLine } from '../data/site';
const year = new Date().getFullYear();
---
<footer class="ftr">
  <div class="wrap">
    <div class="ftr__cta">
      <p class="eyebrow">Your next record starts here</p>
      <h2>Bring your song. <em>Leave with a record.</em></h2>
      <p class="ftr__lede">Sit down with Lucio Rubino, at the studio or on Google Meet. Play him the song and leave with a plan. {packagesLine}</p>
      <DiveInCta center />
      <p class="ftr__ep"><a href="#" data-ep-offer>Get 20% off your EP →</a><span aria-hidden="true"> · </span><a href="/gift-certificates/">Give a session as a gift →</a></p>
    </div>
    <hr class="rule" />
    <div class="ftr__grid">
      <div>
        <Logo />
        <p class="ftr__blurb">Full-song production, recording, mixing and mastering since {b.founded}. In St. Augustine, Fla., and remotely for artists anywhere.</p>
      </div>
      <div>
        <h3 class="ftr__h">Studio</h3>
        <address>
          {b.street}<br />{b.city}, {b.region} {b.postal}<br />
          <a href={`tel:${b.phoneE164}`}>{b.phone}</a><br />
          <a href={`mailto:${b.email}`}>{b.email}</a>
        </address>
        <p class="ftr__small">Sessions by appointment · Remote projects welcome</p>
      </div>
      <div>
        <h3 class="ftr__h">Work</h3>
        <ul>
          <li><a href="/song-production/">Song Production</a></li>
          <li><a href="/services/">Recording · Mixing · Mastering</a></li>
          <li><a href="/film-tv-scoring/">Film & TV Scoring</a></li>
          <li><a href="/commercial-music/">Commercial Music</a></li>
          <li><a href="/services/#assessment">Artist Assessments</a></li>
          <li><a href="/gift-certificates/">Gift certificates</a></li>
          <li><a href="/credits/">Credits</a></li>
        </ul>
      </div>
      <div>
        <h3 class="ftr__h">Follow</h3>
        <ul>
          <li><a href={b.social.instagramStudio} rel="me noopener" target="_blank">Instagram · Studio</a></li>
          <li><a href={b.social.instagramLu} rel="me noopener" target="_blank">Instagram · Lucio</a></li>
          <li><a href={b.social.spotifyLu} rel="me noopener" target="_blank">Spotify · Lucio</a></li>
          <li><a href={b.social.youtube} rel="me noopener" target="_blank">YouTube</a></li>
          <li><a href={b.social.facebook} rel="me noopener" target="_blank">Facebook</a></li>
        </ul>
      </div>
    </div>
    <p class="ftr__legal">© {year} {b.name} · St. Augustine, Florida</p>
  </div>
</footer>

<style>
  .ftr { background: var(--ink-2); border-top: 1px solid var(--line); padding-top: 5rem; }
  .ftr__cta { text-align: center; padding-bottom: 4.5rem; }
  .ftr__cta h2 { max-width: 18ch; margin: 0 auto 1rem; }
  .ftr__lede { margin: 0 auto 2rem; max-width: 56ch; }
  .ftr__ep { margin: 1.4rem 0 0; font-family: var(--font-mono); font-size: .75rem; letter-spacing: .12em; text-transform: uppercase; }
  .ftr__grid { display: grid; gap: 2.5rem; padding: 3.5rem 0; }
  @media (min-width: 760px) { .ftr__grid { grid-template-columns: 1.4fr 1fr 1fr 1fr; } }
  .ftr__blurb { margin-top: 1.2rem; font-size: .95rem; max-width: 34ch; }
  .ftr__h { font-family: var(--font-mono); font-size: .72rem; letter-spacing: .2em; text-transform: uppercase; color: var(--muted); margin-bottom: 1rem; }
  address { font-style: normal; color: var(--cream-dim); font-size: .95rem; line-height: 1.8; }
  ul { list-style: none; padding: 0; margin: 0; }
  li { margin-bottom: .55rem; }
  li a { color: var(--cream-dim); font-size: .95rem; }
  li a:hover { color: var(--amber); }
  .ftr__small { font-size: .8rem; color: var(--muted); margin-top: .8rem; }
  .ftr__legal { font-family: var(--font-mono); font-size: .7rem; letter-spacing: .1em; color: var(--muted); border-top: 1px solid var(--line); padding: 1.5rem 0; margin: 0; }
</style>
